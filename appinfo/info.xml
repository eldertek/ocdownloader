<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>ocdownloader</id>
	<name>ocDownloader</name>
	<summary>Download manager for Nextcloud using Aria2, cURL, and yt-dlp</summary>
	<description><![CDATA[Download manager for Nextcloud using Aria2, cURL, and yt-dlp (with youtube-dl fallback) to download HTTP(S), FTP(S), video streams, Magnet links, and BitTorrent files directly into your Nextcloud storage.]]></description>
	<version>2.0.0</version>
	<licence>AGPL-3.0-or-later</licence>
	<author>e-alfred</author>
	<author>Nibbels</author>
	<author>Xavier Beurois</author>
	<author>André Théo LAURET</author>
	<namespace>Ocdownloader</namespace>
	<types>
		<filesystem/>
	</types>
	<documentation>
		<admin>https://github.com/eldertek/ocdownloader#readme</admin>
	</documentation>
	<category>files</category>
	<category>tools</category>
	<website>https://github.com/eldertek/ocdownloader</website>
	<bugs>https://github.com/eldertek/ocdownloader/issues</bugs>
	<repository type="git">https://github.com/eldertek/ocdownloader.git</repository>
	<screenshot>https://raw.githubusercontent.com/e-alfred/ocdownloader/master/appinfo/Screenshot.jpg</screenshot>
	<donation>https://patreon.com/eldertek</donation>
	<donation>https://github.com/sponsors/eldertek</donation>
	<dependencies>
		<php min-version="8.1" max-version="8.5"/>
		<lib>curl</lib>
		<nextcloud min-version="28" max-version="35"/>
	</dependencies>
	<settings>
		<admin>OCA\Ocdownloader\Settings\Admin</admin>
		<admin-section>OCA\Ocdownloader\Settings\AdminSection</admin-section>
		<personal>OCA\Ocdownloader\Settings\Personal</personal>
		<personal-section>OCA\Ocdownloader\Settings\PersonalSection</personal-section>
	</settings>
	<navigations>
		<navigation>
			<name>ocDownloader</name>
			<route>ocdownloader.index.add</route>
			<icon>ocdownloader.svg</icon>
			<order>99</order>
		</navigation>
	</navigations>
</info>
